{
  "manifest_version": 3,
  "author": "Nijoo",
  "homepage_url": "https://github.com/rockz5555/CopyAllTabUrls",
  "name": "Copy All URLs",
  "version": "1.2.0",
  "description": "Copy every open tab URL in one click — as plain links, titled links, or Markdown. Paste a list back to reopen tabs.",
  "incognito": "spanning",
  "icons": {
    "48": "icons/icon.png",
    "96": "icons/icon-96.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Copy All URLs"
  },
  "permissions": ["tabs", "clipboardRead", "clipboardWrite"],
  "browser_specific_settings": {
    "gecko": {
      "id": "copy-all-urls@nizwer.top",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
